GEMINI_API_KEY=cole_sua_chave_aqui
# reserva gratuita e rapida: https://console.groq.com/keys
GROQ_API_KEY=cole_sua_chave_groq_aqui
# ordem dos provedores (o agente troca sozinho se um cair)
PROVEDORES=groq,gemini

# opcionais
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODELOS_RESERVA=gemini-flash-latest,gemini-flash-lite-latest
GEMINI_THINKING=low
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
GROQ_REASONING=low
# leitura de nota fiscal (visao)
GEMINI_VISION_MODELS=gemini-flash-latest,gemini-3.8-flash,gemini-flash-lite-latest
GROQ_VISION_MODELS=qwen/qwen3.8-27b,meta-llama/llama-4-scout-17b-16e-instruct
