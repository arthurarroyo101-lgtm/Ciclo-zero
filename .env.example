GEMINI_API_KEY=cole_sua_chave_aqui
# reserva gratuita e rapida: https://console.groq.com/keys
GROQ_API_KEY=cole_sua_chave_groq_aqui
# ordem dos provedores (o agente troca sozinho se um cair)
PROVEDORES=gemini,groq

# opcionais
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODELOS_RESERVA=gemini-flash-latest,gemini-flash-lite-latest
GEMINI_THINKING=low
GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile
